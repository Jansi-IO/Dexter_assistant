rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Connection test document
    match /test/{testId} {
      allow get: if true;
    }

    // User profile rules
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create, update, delete: if isOwner(userId);

      // User routines subcollection
      match /routines/{routineId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId) && isValidId(routineId);
        allow create, update, delete: if isOwner(userId) && isValidId(routineId);
      }

      // User scripts subcollection
      match /scripts/{scriptId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId) && isValidId(scriptId);
        allow create, update, delete: if isOwner(userId) && isValidId(scriptId);
      }

      // User execution logs subcollection
      match /logs/{logId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId) && isValidId(logId);
        allow create, update, delete: if isOwner(userId) && isValidId(logId);
      }

      // User media records (transcriptions, search grounding, live session audio)
      match /media/{mediaId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId) && isValidId(mediaId);
        allow create, update, delete: if isOwner(userId) && isValidId(mediaId);
      }
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
